[hub]
url = "http://localhost:8000"
client_id = ""
client_secret = ""

[bbs]
name = "My BBS"

[sync]
sent_action = "archive"
archive_dir = "./sent"
max_retries = 3
retry_delay = 5
timeout_seconds = 120
metrics_file = "./metrics.json"

# Daemon mode configuration (for daemon.py)
# These settings are only used when running in daemon mode
[daemon]
enabled = true
sync_interval = 120               # seconds between Nova Hub sync polls
maintenance_interval = 600        # seconds between scheduled game maintenance runs
maintenance_timeout = 300         # max seconds to wait for game maintenance to complete
run_maintenance_on_download = true # run maintenance immediately when packets arrive

# Linux-only: dosemu configuration
dosemu_path = "/usr/bin/dosemu"
dosemu_config_dir = "./dosemu_configs"

# dosemu2 refuses to start unless TERM names a terminal that can clear the
# screen. Under systemd there is no controlling terminal, so script(1) sets
# TERM=dumb and dosemu exits immediately leaving a ~330-byte log. Leave this
# alone unless you have a reason.
dosemu_term = "linux"
log_dir = "./logs"

# Define your leagues here
# BBS ID is assigned per league and should match what's configured in the hub admin interface

# Example BRE league configuration
[leagues.BRE.555]
enabled = true
bbs_index = 2  # Your BBS ID for this league (integer 1-255)
outbound_dir = "./test_data/bre_555/outbound"
inbound_dir = "./test_data/bre_555/inbound"

# Game execution settings (required for daemon mode)
#
# game_folder is ALWAYS a path this machine can open - a real path on the
# host OS. On Linux that is the directory dosemu presents as C:, NOT the
# DOS path. Putting a "C:\..." path here on Linux is the easy mistake:
# nothing can stat it, so maintenance fails with "game_folder does not
# exist" and never launches dosemu at all.
#
# On Windows:
game_folder = "C:\\BBS\\BRE"
#
# On Linux, the host path and the DOS path are two different settings:
# game_folder   = "/home/user/.dosemu/drive_c/bbs/bre"   # what Linux sees
# game_dos_path = "C:\\BBS\\BRE"                         # what DOS sees
#
# game_dos_path is Linux-only; it is written into the generated batch file
# as the CD target and is ignored on Windows.
game_dos_path = "C:\\BBS\\BRE"

game_command = "BRE"                       # Executable name (without path)
maintenance_args = "PLANETARY"             # Arguments for maintenance command

# Example Falcon's Eye league configuration
[leagues.FE.123]
enabled = true
bbs_index = 3  # Different BBS ID for different league
outbound_dir = "./test_data/fe_123/outbound"
inbound_dir = "./test_data/fe_123/inbound"

# Game execution settings (required for daemon mode)
game_folder = "C:\\BBS\\FE"
game_command = "FE"
maintenance_args = "PLANETARY"
game_dos_path = "C:\\BBS\\FE"
